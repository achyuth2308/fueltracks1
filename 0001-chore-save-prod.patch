+    vehicleId: '',
+    startDate: new Date().toISOString().split('T')[0],
+    endDate: new Date().toISOString().split('T')[0],
+    speedLimit: 60
+  });
+
+  useEffect(() => {
+    vehicleApi.getVehicles({ t: Date.now() })
+      .then(res => { if (res.success) setVehicles(res.data); })
+      .catch(console.error);
