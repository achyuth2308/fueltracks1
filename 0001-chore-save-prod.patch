+    iconSize: [26, totalHeight],
+    iconAnchor: [13, clusterRank > 0 ? totalHeight : 32],
+    popupAnchor: overrideOptions.popupAnchor || [0, clusterRank > 0 ? -totalHeight : -32],
+  });
+};
+
+export const createTeardropIcon = createPinIcon;
