+                {immobilizerLoading && <Loader2 size={16} className="animate-spin" />}
+                <span>
+                  {immobilizerLoading
+                    ? 'Dispatching Command...'
+                    : vehicle.is_immobilized
+                    ? 'Confirm Restore Engine'
+                    : 'Confirm Immobilize Vehicle'}
+                </span>
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
+
+
+export default VehicleDetailPage;
