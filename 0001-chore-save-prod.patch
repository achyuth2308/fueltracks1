+                  </tr>
+                  <tr>
+                    <td style={{ color: '#4b5563', fontWeight: 600, padding: '2px 0' }}>Reason</td>
+                    <td style={{ color: '#ef4444', fontWeight: 700, padding: '2px 0' }}>- Device Offline</td>
