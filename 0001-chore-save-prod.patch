+      'End Time': row.end_time ? formatLocalTime(row.end_time) : 'N/A',
+      'End Loc': row.destination || ((row.end_lat && row.end_lng) ? `Lat: ${row.end_lat}, Lng: ${row.end_lng}` : 'N/A'),
+      'Duration (hh:mm:ss)': formatDuration(row.duration_secs || row.duration_seconds),
+      'Distance (km)': row.distance_km || row.distance || 0,
