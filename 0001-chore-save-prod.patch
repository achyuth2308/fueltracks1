new file mode 100644
index 0000000..ad249f2
--- /dev/null
+++ b/backend/fix_today_distance.js
@@ -0,0 +1,73 @@
+const path = require('path');
+require('dotenv').config({ path: path.join(__dirname, '..', '.env') });
+const { Pool } = require('pg');
+
+const pool = new Pool({
+  host: process.env.DB_HOST || '127.0.0.1',
+  port: parseInt(process.env.DB_PORT) || 5432,
+  user: process.env.DB_USER || 'postgres',
+  password: process.env.DB_PASS,
+  database: process.env.DB_NAME || 'fueltracks',
+});
+
+async function fixTodayDistance() {
+  console.log('Starting mass recalculation of today_distance for all active vehicles...');
+  const client = await pool.connect();
+  try {
+    // We will use the exact logic from the History Page, but in SQL.
+    // It filters out bounds, applies wasMoving, and caps distance.
+    const query = `
+      WITH moving_points AS (
+        SELECT 
+          vehicle_id, 
+          lat, 
+          lng, 
+          device_time,
+          speed,
+          ignition,
+          LAG(lat) OVER (PARTITION BY vehicle_id ORDER BY device_time) as prev_lat, 
+          LAG(lng) OVER (PARTITION BY vehicle_id ORDER BY device_time) as prev_lng,
+          LAG(speed) OVER (PARTITION BY vehicle_id ORDER BY device_time) as prev_speed,
+          LAG(ignition) OVER (PARTITION BY vehicle_id ORDER BY device_time) as prev_ignition
+        FROM gps_points
+        WHERE device_time >= (NOW() AT TIME ZONE 'Asia/Kolkata')::date
+          AND lat > 6.5 AND lat < 37.5 AND lng > 68.0 AND lng < 98.0
+      ),
+      distances AS (
+        SELECT 
+          vehicle_id,
+          (6371 * acos(least(1.0, 
+            cos(radians(prev_lat)) * cos(radians(lat)) * cos(radians(lng) - radians(prev_lng)) + 
+            sin(radians(prev_lat)) * sin(radians(lat))
+          ))) as dist
+        FROM moving_points
+        WHERE prev_lat IS NOT NULL AND (prev_lat != lat OR prev_lng != lng)
+          AND ( (speed > 3 OR ignition = true) OR (prev_speed > 3 OR prev_ignition = true) )
+      ),
+      aggregated AS (
+        SELECT 
+          vehicle_id,
+          ROUND(CAST(COALESCE(SUM(dist), 0) AS numeric), 3) as total_dist
+        FROM distances
+        WHERE dist > 0.01 AND dist < 5
+        GROUP BY vehicle_id
+      )
+      UPDATE vehicle_latest_state vls
+      SET today_distance = a.total_dist
+      FROM aggregated a
+      WHERE vls.vehicle_id = a.vehicle_id
+      AND vls.today_distance_date >= (NOW() AT TIME ZONE 'Asia/Kolkata')::date;
+    `;
+    
+    console.log('Executing massive recalculation query... Please wait...');
+    const result = await client.query(query);
+    console.log(`Successfully recalculated and fixed today_distance for ${result.rowCount} vehicles!`);
+  } catch (error) {
+    console.error('Error recalculating distances:', error);
+  } finally {
+    client.release();
+    pool.end();
+  }
+}
+
+fixTodayDistance();
diff --git a/backend/fix_today_distance_perfect.js b/backend/fix_today_distance_perfect.js
new file mode 100644
index 0000000..239526c
--- /dev/null
+++ b/backend/fix_today_distance_perfect.js
@@ -0,0 +1,101 @@
+const path = require('path');
+require('dotenv').config({ path: path.join(__dirname, '..', '.env') });
+const { Pool } = require('pg');
+
+const pool = new Pool({
+  host: process.env.DB_HOST || '127.0.0.1',
+  port: parseInt(process.env.DB_PORT) || 5432,
+  user: process.env.DB_USER || 'postgres',
+  password: process.env.DB_PASS,
+  database: process.env.DB_NAME || 'fueltracks',
+});
+
+function calculateDistance(lat1, lon1, lat2, lon2) {
+  const R = 6371; // Radius of the earth in km
+  const dLat = (lat2 - lat1) * Math.PI / 180;
+  const dLon = (lon2 - lon1) * Math.PI / 180;
+  const a = 
+    Math.sin(dLat/2) * Math.sin(dLat/2) +
+    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
+    Math.sin(dLon/2) * Math.sin(dLon/2); 
+  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); 
+  return R * c; // Distance in km
+}
+
+async function fixDistancesPerfectly() {
+  console.log('Starting perfect JS-based recalculation to match History Page exactly...');
+  const client = await pool.connect();
+  try {
+    const today = new Date();
+    const startOfDay = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 0, 0, 0);
+    const startStr = startOfDay.toISOString();
+
+    const { rows: vehicles } = await client.query(`SELECT id FROM vehicles`);
+    let updatedCount = 0;
+
+    for (const v of vehicles) {
+      const { rows: points } = await client.query(`
+        SELECT lat, lng, speed, ignition, device_time
+        FROM gps_points 
+        WHERE vehicle_id = $1 
+          AND device_time >= (NOW() AT TIME ZONE 'Asia/Kolkata')::date
+          AND lat > 6.5 AND lat < 37.5 AND lng > 68.0 AND lng < 98.0
+        ORDER BY device_time ASC
+      `, [v.id]);
+
+      if (points.length === 0) continue;
+
+      const driftFiltered = [];
+      let lastValid = null;
+
+      for (const p of points) {
+        p.speed = parseFloat(p.speed) || 0;
+        p.lat = parseFloat(p.lat);
+        p.lng = parseFloat(p.lng);
+
+        if (!lastValid) {
+          driftFiltered.push(p);
+          lastValid = p;
+          continue;
+        }
+        
+        const isMoving = p.speed > 3 || p.ignition;
+        const wasMoving = lastValid.speed > 3 || lastValid.ignition;
+
+        if (isMoving || wasMoving) {
+          driftFiltered.push(p);
+          lastValid = p;
+        }
+      }
+
+      let cumulativeDist = 0;
+      for (let i = 1; i < driftFiltered.length; i++) {
+        const p1 = driftFiltered[i - 1];
+        const p2 = driftFiltered[i];
+        const segDist = calculateDistance(p1.lat, p1.lng, p2.lat, p2.lng);
+        if (segDist > 0.01 && segDist < 5) {
+          cumulativeDist += segDist;
+        }
+      }
+
+      const totalDist = parseFloat(cumulativeDist.toFixed(3));
+
+      await client.query(`
+        UPDATE vehicle_latest_state 
+        SET today_distance = $1 
+        WHERE vehicle_id = $2
+      `, [totalDist, v.id]);
+      
+      updatedCount++;
+    }
+
+    console.log(`Successfully perfectly synced ${updatedCount} vehicles with History Page logic!`);
+  } catch (err) {
+    console.error(err);
+  } finally {
+    client.release();
+    pool.end();
+  }
+}
+
+fixDistancesPerfectly();
