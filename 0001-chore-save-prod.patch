+    if (!isMountedRef.current) {
+      isMountedRef.current = true;
+      prevLatLngRef.current = { lat: targetLat, lng: targetLng };
+      marker.setLatLng([targetLat, targetLng]);
+      return;
+    }
+
+    const prev = prevLatLngRef.current;
+    if (!prev) {
