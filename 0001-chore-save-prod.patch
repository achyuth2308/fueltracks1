+      {/* Feed */}
+      <div ref={listRef} style={{ flex: 1, overflowY: 'auto', padding: '16px 24px' }}>
+        {liveAlerts.length === 0 ? (
+          <div style={{ textAlign: 'center', padding: '60px 20px', color: '#9CA3AF' }}>
+            <Radio size={48} color="#E2E8F0" style={{ marginBottom: '12px' }} />
