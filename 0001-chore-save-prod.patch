+  if (lines[i].includes('Error') && !lines[i].includes('CORS')) {
+    console.log(lines.slice(Math.max(0, i-5), i+15).join('\n'));
+    console.log('---------------------------');
+    count++;
+    if (count > 5) break;
+  }
+}
