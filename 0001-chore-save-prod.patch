diff --git a/get_all_sathya.js b/get_all_sathya.js
new file mode 100644
index 0000000..a80564d
--- /dev/null
+++ b/get_all_sathya.js
@@ -0,0 +1,13 @@
+const db = require('./backend/config/db');
+async function run() {
+  const orgs = await db.query("SELECT id, name FROM organizations WHERE name ILIKE '%sathya%'");
+  console.log("Found orgs:", orgs.rows);
+  
+  for (let org of orgs.rows) {
+      const res = await db.query("SELECT plate, imei FROM vehicles WHERE org_id = $1 ORDER BY plate", [org.id]);
+      console.log(`Vehicles in ${org.name}:`, res.rows.length);
+      console.log(JSON.stringify(res.rows, null, 2));
+  }
+  process.exit(0);
+}
+run();
diff --git a/get_groups.js b/get_groups.js
new file mode 100644
index 0000000..8ce1731
--- /dev/null
+++ b/get_groups.js
@@ -0,0 +1,18 @@
+const db = require('./backend/config/db');
+async function run() {
+  const grps = await db.query("SELECT id, name FROM groups WHERE name ILIKE '%sathya%'");
+  console.log("Groups:", grps.rows);
+  
+  for (let grp of grps.rows) {
+      const res = await db.query(`
+          SELECT v.plate, v.imei 
+          FROM vehicles v 
+          JOIN vehicle_groups vg ON v.id = vg.vehicle_id 
+          WHERE vg.group_id = $1
+      `, [grp.id]);
+      console.log(`Vehicles in group ${grp.name}:`, res.rows.length);
+      console.log(JSON.stringify(res.rows, null, 2));
+  }
+  process.exit(0);
+}
+run();
