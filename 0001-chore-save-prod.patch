+  const [selectedGroupId, setSelectedGroupId] = useState('');
+
+  // New Flow State
+  const [newOrg, setNewOrg] = useState({ name: '', phone: '', email: '' });
+  const [newUser, setNewUser] = useState({ name: '', mobile: '', email: '', password: '' });
