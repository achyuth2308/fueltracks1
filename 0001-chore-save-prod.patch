+            return (
+              <button
+                key={tab.id}
+                onClick={() => setActiveTab(tab.id)}
+                style={{
+                  display: 'flex', alignItems: 'center', gap: '8px',
+                  padding: '14px 20px', background: 'none', border: 'none', cursor: 'pointer',
+                  fontSize: '13px', fontWeight: active ? 700 : 500,
